# Copy to .env.local and fill in. Never commit .env.local.

# Data source: "demo" (default, in-memory seeded portfolio) or "supabase" (not implemented yet)
DATA_SOURCE=demo

# IANA timezone used to decide what "today" is for overdue / upcoming calculations
APP_TIMEZONE=UTC

# --- Supabase (next phase) ---
# Public URL and anon key are safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (future AI features) --- server-only
ANTHROPIC_API_KEY=
