# Copy to .env.local and fill in. Never commit .env.local.

# Data source: "local" (default, JSON file seeded from demo data) or "supabase" (not implemented yet)
DATA_SOURCE=local
# The local store lives in .data/portfolio.json. Run `npm run data:reset`
# to start again from demo data.

# IANA timezone used to decide what "today" is for overdue / upcoming calculations
APP_TIMEZONE=UTC

# --- Supabase (next phase) ---
# Public URL and anon key are safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (future AI features) --- server-only
ANTHROPIC_API_KEY=
